{
  "expo": {
    "name": "TreinaAI",
    "slug": "fitapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0D",
          "imageWidth": 240
        }
      ],
      "expo-asset",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "O TreinaAI usa a foto que você escolher para montar a imagem do treino. A foto fica só no seu celular.",
          "cameraPermission": "O TreinaAI usa a câmera para você tirar a foto do treino. A foto fica só no seu celular.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O TreinaAI precisa de acesso às Fotos para salvar a imagem do treino.",
          "savePhotosPermission": "O TreinaAI salva a imagem do treino nas suas Fotos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
