# Copie para .env e preencha. O .env nunca vai para o git.
# EXPO_PUBLIC_* vai dentro do app: só URL e anon key do Supabase e a URL do Ollama local.

# App
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Ollama na rede local, ex.: http://192.168.x.x:11434
EXPO_PUBLIC_OLLAMA_URL=

# Scripts de importação (scripts/), rodam só no computador
SUPABASE_KEY=
# Chave da TacoAPI (RapidAPI) para scripts/test-sync.ts; na function vai como secret RAPIDAPI_KEY
RAPIDAPI_KEY=

# Edge Function sincronizar-bases: secret SINCRONIZAR_SEGREDO (só no servidor);
# quem chama manda o mesmo valor no cabeçalho x-sincronizar-segredo (POST).
SINCRONIZAR_SEGREDO=
